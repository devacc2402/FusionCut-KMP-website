# Env / secrets
.env
.env.*
!.env.example

# Installer binaries — deliberately NOT in git.
# The MSI alone is 107 MB, and GitHub hard-rejects any file over 100 MB,
# so committing it makes the push fail outright. Keep the folder (via
# .gitkeep) so `npm run dev` still works locally, and publish the real
# files as GitHub Release assets instead. See "Deploying" in README.md.
public/downloads/*
!public/downloads/.gitkeep
